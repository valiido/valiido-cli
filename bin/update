#!/bin/sh
# Update every dependency to its latest release. Python requirements are never pinned,
# so only the local import tool environment needs a refresh.
set -eu

cd "$(dirname "$0")/.."

echo "Go modules"
go get -u ./...
go mod tidy

venv=skills/valiido/scripts/.venv
if [ -x "$venv/bin/python" ]; then
  echo "Python packages"
  "$venv/bin/python" -I -m pip install -q --upgrade pip
  "$venv/bin/python" -I -m pip install -q --upgrade -r skills/valiido/scripts/requirements.txt
  if [ -f tests/requirements.txt ]; then
    "$venv/bin/python" -I -m pip install -q --upgrade -r tests/requirements.txt
  fi
fi

git --no-pager diff --stat -- go.mod go.sum
