#!/bin/sh
set -eu

cd "$(dirname "$0")/.."

quality_tmp=$(mktemp -d)
trap 'rm -rf "$quality_tmp"' EXIT HUP INT TERM

unformatted=$(gofmt -l .)
if [ -n "$unformatted" ]; then
  printf 'Files need gofmt:\n%s\n' "$unformatted" >&2
  exit 1
fi

go mod verify
go mod tidy -diff
go vet ./...
go test -race ./...
go build -trimpath -o "$quality_tmp/valiido" ./cmd/valiido
GOOS=windows GOARCH=amd64 go build -trimpath -o "$quality_tmp/valiido.exe" ./cmd/valiido

scripts=skills/valiido/scripts
python=${VALIIDO_PYTHON:-python3}
if [ -z "${VALIIDO_PYTHON:-}" ] && [ -x "$scripts/.venv/bin/python" ]; then
  python=$scripts/.venv/bin/python
fi
PYTHONDONTWRITEBYTECODE=1 "$python" -I tests/test_import_tool.py
